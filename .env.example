# ============================================================
# ASM Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- General ---
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_64_HERE

# --- PostgreSQL ---
POSTGRES_DB=asmdb
POSTGRES_USER=asmuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# --- RabbitMQ ---
RABBITMQ_USER=asm
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password_here

# --- MinIO ---
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key_32chars

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- API ---
API_WORKERS=4
ENABLE_METRICS=true
ALLOWED_ORIGINS=https://your-domain.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
GRAFANA_ROOT_URL=https://your-domain.com/grafana

# --- Scanning ---
SCAN_INTERVAL_HOURS=24
RUN_FULL_SCAN_ON_START=false
DISCOVERY_CONCURRENCY=3
PORT_CONCURRENCY=3
CRAWL_CONCURRENCY=2
ENRICHMENT_CONCURRENCY=2
VALIDATION_CONCURRENCY=2
VALIDATION_STALE_HOURS=24
VALIDATION_REFRESH_HOURS=24
VALIDATION_REFRESH_LIMIT=250
NUCLEI_RATE_LIMIT=150

# ============================================================
# NOTIFICATION CHANNELS (Optional)
# ============================================================
# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# Slack
SLACK_WEBHOOK_URL=

# Discord
DISCORD_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# WORKER SCALING (Optional)
# ============================================================
DISCOVERY_CONCURRENCY=3
PORT_CONCURRENCY=3
CRAWL_CONCURRENCY=2
ENRICHMENT_CONCURRENCY=2
VALIDATION_CONCURRENCY=2
VALIDATION_STALE_HOURS=24
VALIDATION_REFRESH_HOURS=24
VALIDATION_REFRESH_LIMIT=250
NUCLEI_RATE_LIMIT=150
